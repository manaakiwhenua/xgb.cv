seq(5,40,5)
library(simr)
library(lme4)
library(parallel)
library(tidyr)
file_path <- r"[C:\Users\MasonN\OneDrive - MWLR\MFE LUCAS Carbon Power\Power analyses and alert levels\]"
newdata <-   read.csv(paste(file_path,
"Data/Natural Forest Plot level Carbon Estimates_5-yrcycle_doubled.csv",
sep = ""),
header = T)
fc <- read.csv(paste(file_path,
"Data/Natural Forest Plot level Carbon Estimates_edited.csv",
sep = ""),
header = T)
fc <- fc[,c("group", "Ys", "plot", "totalC")]
EpisodicEffectSize = read.csv(paste0(file_path,"Data/EpisodicScenarioEffects.csv"))
scen = 1
EffectSizes = vector(length = 0)
year = vector(length = 0)
EffectSizeLevels = quantile(EpisodicEffectSize[,scen],prob = c(0.05,0.1,0.5,0.9,0.95))
for(level in 1:length(EffectSizeLevels))
{
year <- c(year, seq(5,40,5))
EffectSizes <- c(EffectSizes,rep(EffectSizeLevels[level],times  = length(seq(5,40,5))))
}
year
EffectSizes
n <- length(EffectSizes)
n
nplot <- round(c(length(unique(fc$plot[fc$group < 3]))*c(0.5, 1,1.5,2)))
maxplot <- length(unique(fc$plot[fc$group < 3]))*2
R <- 10
cl <- makeCluster(detectCores())
clusterEvalQ(cl = cl, {
library(lme4)
library(simr)
library(tidyr)
})
# call relevant datasets
system.time(clusterExport(cl, c("fc",
"newdata",
"R", # replicates
"EffectSizes",
"year",
"nplot",
"maxplot",
"file_path")))
power5 <- function (i) {
# fit base model
lm1 <- lmer(totalC ~ Ys + (1|plot) ,
data=fc)
# control= lmerControl( optCtrl  =list(maxfun = 1000000)))
newdata1   <- as.data.frame(cbind (newdata [newdata$original == F & newdata$Ys < year[i],],
totalC = predict (lm1, newdata = newdata[newdata$original == F & newdata$Ys < year[i],],
re.form = NA,
type = "response")))
newdata2 <- rbind(fc[fc$group < 3,],
newdata1[,c("group", "Ys", "plot", "totalC")])
getData(lm1) <- newdata2
# specify trend to simulate
fixef(lm1)["Ys"] <- EffectSizes[i]
yc5 <- powerCurve(lm1, fixed("Ys"), along = "plot", nsim = R, breaks = nplot)
summary(yc5)
power.b5 <- cbind( EffectSizes = EffectSizes[i],
years = year[i],
summary(yc5))
}
print("5-yr")
print(system.time({
out_parLapply_5 <-
parLapply(cl = cl, 1:n, fun = power5)
print(system.time({
out_parLapply_5 <-
parLapply(cl = cl, 1:n, fun = power5)
}))
power5.all <- do.call(rbind, out_parLapply_5)
cl <- makeCluster(detectCores())
clusterEvalQ(cl = cl, {
library(lme4)
library(simr)
library(tidyr)
})
system.time(clusterExport(cl, c("fc",
"newdata",
"R", # replicates
"EffectSizes",
"year",
"nplot",
"maxplot",
"file_path")))
