library(foreign)
library(dplyr)
source(r"[T:\Hamilton\Projects P-T\Spatlab\Development\SL1714_RLibrary_smap-dsm\R\grid-core-terra.r]")
source(r"[T:\Hamilton\Projects P-T\Spatlab\Development\SL1714_RLibrary_smap-dsm\R\write-metadata.R]")
#Parameters----
prm.path.analysis <- r"[R:\Projects\SL2401_MPI_ETSYieldTables\Analysis\A09_RadiataGridcore]"
dir.create(prm.path.analysis)
PointSampleFile = r"[R:\Projects\SL2401_MPI_ETSYieldTables\Analysis\A09_RadiataGridcore\RadiataBalancedSample.csv]"
#PointSample = read.delim(PointSampleFile,as.is  = TRUE)
prm.file.xy <- PointSampleFile
prm.field.x <- "POINT_X"
prm.field.y <- "POINT_Y"
prm.file.altitude <- r"[N:\Projects\BaseData\NZ\Landform\Elevation\vLENZ10\100m\elevation]"
prm.file.nzmat <- r"[N:\Projects\BaseData\NZ\Climate\Temperature\v2003\100m\nz_mat]"
prm.path.rainfal <- r"[N:\Projects\BaseData\NZ\Climate\Rainfall\v2003\100m\nz_mar]"
prm.path.slope <- r"[N:\Projects\BaseData\NZ\Landform\Slope\vLENZ10\100m\slope]"
prm.path.acidp <- r"[N:\Projects\BaseData\NZ\Soils\acidp\vLENZ10\100m\acidp]"
prm.path.deficit <- r"[N:\Projects\BaseData\NZ\Climate\WaterDeficit\vLENZ10\100m\deficit]"
prm.path.LCDB <- r"[N:\Projects\BaseData\NZ\LandCover\LCDB5\lris-lcdb-v50\25m\lcdb50_2012]"
prm.path.forest <- r"[R:\Projects\SL2401_MPI_ETSYieldTables\Data\GIS\Grids]"
prm.path.fastigata <- r"[R:\Projects\SL2401_MPI_ETSYieldTables\Data\GIS\Grids\ExoticPlantationRange\100mRes]"
#Data----
grc <- Gridcore()
grc$set.file.xy(filename = prm.file.xy, x.column = prm.field.x, y.column = prm.field.y, EPSG = EPSG.NZTM(),sep = ",")
grc$set.layers.add.raster(filepath = dirname(prm.file.altitude), filename = basename(prm.file.altitude), EPSG = EPSG.NZMG())
grc$set.layers.add.raster(filepath = dirname(prm.file.nzmat), filename = basename(prm.file.nzmat), EPSG = EPSG.NZMG())
grc$set.layers.add.raster(filepath = dirname(prm.path.rainfal), filename = basename(prm.path.rainfal), EPSG = EPSG.NZMG())
grc$set.layers.add.raster(filepath = dirname(prm.path.slope), filename = basename(prm.path.slope), EPSG = EPSG.NZMG())
grc$set.layers.add.raster(filepath = dirname(prm.path.acidp), filename = basename(prm.path.acidp), EPSG = EPSG.NZMG())
grc$set.layers.add.raster(filepath = dirname(prm.path.deficit), filename = basename(prm.path.deficit), EPSG = EPSG.NZMG())
grc$set.layers.add.raster(filepath = dirname(prm.path.LCDB), filename = basename(prm.path.LCDB), EPSG = EPSG.NZMG())
grc$set.layers.add.raster(filepath = prm.path.forest, filename = "A07_S02_Forest4km.tif", EPSG = EPSG.NZTM())
grc$set.layers.add.raster(filepath = prm.path.fastigata, filename = "Fastigata_Int.tif", EPSG = EPSG.NZTM())
grc$do.check.parameters()
df.gc <- grc$do.run(resultFolder = prm.path.analysis, resultGridcore = "RadiataBalancedSample_Gridcore.txt", returnResult = T)
head(df.gc)
