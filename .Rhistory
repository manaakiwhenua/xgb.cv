power5 <- function (i) {
# fit base model
lm1 <- lmer(totalC ~ Ys + (1|plot) ,
data=fc)
# control= lmerControl( optCtrl  =list(maxfun = 1000000)))
newdata1   <- as.data.frame(cbind (newdata [newdata$original == F & newdata$Ys < year[i],],
totalC = predict (lm1, newdata = newdata[newdata$original == F & newdata$Ys < year[i],],
re.form = NA,
type = "response")))
newdata2 <- rbind(fc[fc$group < 3,],
newdata1[,c("group", "Ys", "plot", "totalC")])
getData(lm1) <- newdata2
# specify trend to simulate
fixef(lm1)["Ys"] <- EffectSizes[i]
yc5 <- powerCurve(lm1, fixed("Ys"), along = "plot", nsim = R, breaks = nplot)
summary(yc5)
power.b5 <- cbind( EffectSizes = EffectSizes[i],
years = year[i],
summary(yc5))
}
print("5-yr")
print(system.time({
out_parLapply_5 <-
parLapply(cl = cl, 1:n, fun = power5)
}))
power5.all <- do.call(rbind, out_parLapply_5)
power5.all
